# Puertos y red
PORT=3030
HOST=127.0.0.1

# Token que usará la web para llamar a este bot (cámbialo)
BOT_TOKEN=cambia-este-token-secreto

# Carpeta donde se guarda la sesión de WhatsApp (NUNCA subir a git)
AUTH_DIR=./auth_info_baileys

# Nivel de log de Baileys: silent | warn | info | debug
LOG_LEVEL=silent