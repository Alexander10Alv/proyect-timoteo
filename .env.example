# Database (MySQL / XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/heartcry_db"

# Auth
JWT_SECRET="cambia-este-secreto-en-produccion"
# Secreto de sesión para el CRUD admin de Joshua Project (cookie httpOnly + JWT HS256).
# Genera tu propio valor (p. ej. `openssl rand -base64 32`) y ponlo en tu .env local, nunca aquí.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Bot de WhatsApp (whatsapp-bot / Baileys) ──────────────
# El admin envía por el bot local (whatsapp-bot/ en el puerto 3030).
WHATSAPP_BOT_URL="http://127.0.0.1:3030"
WHATSAPP_BOT_TOKEN="cambia-este-token"

# ─── Email transaccional (mailService → SMTP) ─────────────
# Envíos reales por SMTP con nodemailer (Brevo / SendGrid / SES).
MAIL_SMTP_HOST="smtp-relay.brevo.com"
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER="tu-usuario@smtp-brevo.com"
MAIL_SMTP_PASS="tu-smtp-key"
MAIL_FROM="Proyecto Timoteo <no-reply@proyectotimoteo.org>"
MAIL_SENDER_NAME="Proyecto Timoteo"

# ─── Pasarela de pagos (paymentService) ───────────────────
# PayPal REST o Stripe. Vacío = modo MOCK.
NEXT_PUBLIC_PAYMENT_PROVIDER=""
NEXT_PUBLIC_PAYMENT_API_URL=""
NEXT_PUBLIC_PAYMENT_CLIENT_ID=""
NEXT_PUBLIC_PAYMENT_CLIENT_SECRET=""SUNAT_API_TOKEN=
